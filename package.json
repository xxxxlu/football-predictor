{
  "name": "football-predictor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.4.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build:packages": "pnpm --filter './packages/**' -r build",
    "dev:web": "pnpm --filter @football-predictor/config build && node scripts/dev-web.mjs",
    "dev:worker": "pnpm --filter @football-predictor/worker dev",
    "supplier:prewarm": "pnpm build:packages && pnpm --filter @football-predictor/worker build && pnpm --filter @football-predictor/worker prewarm",
    "supplier:current-world-cup": "pnpm build:packages && pnpm --filter @football-predictor/worker build && pnpm --filter @football-predictor/worker current-world-cup",
    "db:migrate": "pnpm --filter @football-predictor/db migrate",
    "db:seed:super-admins": "pnpm --filter @football-predictor/db seed:super-admins",
    "db:seed:f1-2026": "pnpm --filter @football-predictor/db seed:f1-2026",
    "db:seed:f1-official-2026": "pnpm --filter @football-predictor/db seed:f1-official-2026",
    "db:seed:e2e": "pnpm --filter @football-predictor/db seed:e2e",
    "lint": "pnpm --filter @football-predictor/web lint",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck",
    "test": "pnpm build:packages && vitest run",
    "build": "pnpm build:packages && pnpm --filter @football-predictor/worker build && pnpm --filter @football-predictor/web build",
    "cloudbase:prepare-package": "node scripts/cloudbase-packaging.mjs",
    "verify:workspace": "node --test scripts/workspace-structure.test.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "test:e2e": "pnpm --filter @football-predictor/web test:e2e",
    "test:perf": "node scripts/perf-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "next": "16.2.11",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": ">=8.5.10",
      "next>sharp": ">=0.35.0"
    }
  }
}
