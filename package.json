{
  "name": "pulse",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.4.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build:packages": "pnpm --filter './packages/**' -r build",
    "dev:web": "pnpm --filter @pulse/config build && node scripts/dev-web.mjs",
    "dev:worker": "pnpm --filter @pulse/worker dev",
    "supplier:prewarm": "pnpm build:packages && pnpm --filter @pulse/worker build && pnpm --filter @pulse/worker prewarm",
    "supplier:sweep": "pnpm build:packages && pnpm --filter @pulse/worker build && pnpm --filter @pulse/worker sweep",
    "db:migrate": "pnpm --filter @pulse/db migrate",
    "db:seed:super-admins": "pnpm --filter @pulse/db seed:super-admins",
    "db:seed:f1-2026": "pnpm --filter @pulse/db seed:f1-2026",
    "db:seed:f1-official-2026": "pnpm --filter @pulse/db seed:f1-official-2026",
    "db:import:f1-results-2026": "pnpm build:packages && pnpm --filter @pulse/db import:f1-results-2026",
    "db:seed:e2e": "pnpm --filter @pulse/db seed:e2e",
    "db:close-settled-rooms": "pnpm --filter @pulse/db close-settled-rooms",
    "lint": "pnpm --filter @pulse/web lint",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck",
    "test": "pnpm build:packages && vitest run",
    "build": "pnpm build:packages && pnpm --filter @pulse/worker build && pnpm --filter @pulse/web build",
    "cloudbase:prepare-package": "node scripts/cloudbase-packaging.mjs",
    "verify:workspace": "node --test scripts/workspace-structure.test.mjs",
    "verify:production-health": "pnpm --filter @pulse/db health-check",
    "smoke": "node scripts/smoke-test.mjs",
    "test:e2e": "pnpm --filter @pulse/web test:e2e",
    "test:perf": "node scripts/perf-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "next": "16.2.11",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
