{
  "name": "@football-predictor/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "prewarm": "node --env-file-if-exists=../../.env dist/prewarm.js",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@football-predictor/api-football": "workspace:*",
    "@football-predictor/config": "workspace:*",
    "@football-predictor/db": "workspace:*",
    "@football-predictor/domain": "workspace:*"
  }
}
