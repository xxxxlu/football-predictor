# Runtime environment. Never commit real secrets.
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=info

# Identity and rules (server-only)
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse
RULES_VERSION=rules-2026-07
SESSION_TTL_DAYS=30
# One-shot bootstrap values only. A successful first-login password change updates
# the database hash and revokes old sessions; it never writes the new password back
# to this file. Re-running the seed does not overwrite an existing admin password.
SUPER_ADMIN_1_USERNAME=
SUPER_ADMIN_1_PASSWORD=
SUPER_ADMIN_2_USERNAME=
SUPER_ADMIN_2_PASSWORD=

# Supplier (server-only; never expose with NEXT_PUBLIC_ prefix)
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_BOOKMAKER_ID=8

# Free current World Cup 1X2 odds. Cached globally for 2 hours (up to 372 credits in 31 days).
THE_ODDS_API_KEY=
# API-FOOTBALL Free currently supports seasons 2022-2024, not 2026.
# Leave these blank unless a paid/current-season API-FOOTBALL plan is configured.
# Current 2026 World Cup fixtures are synchronized on demand from OpenLigaDB
# without a key; old fixtures are excluded from the user-facing match list.
SUPPLIER_COMPETITIONS=
SUPPLIER_REFERENCE_DATE=
# Blank legacy values are ignored whenever SUPPLIER_COMPETITIONS is set.
SUPPLIER_LEAGUE_ID=
SUPPLIER_SEASON=
SUPPLIER_WINDOW_PAST_DAYS=13
SUPPLIER_WINDOW_FUTURE_DAYS=1
SUPPLIER_FIXTURES_INTERVAL_MINUTES=720
SUPPLIER_RESULTS_INTERVAL_MINUTES=1440
SUPPLIER_ODDS_INTERVAL_MINUTES=10
SUPPLIER_SETTLEMENT_INTERVAL_SECONDS=60
SUPPLIER_SETTLEMENT_BATCH_SIZE=100
# Phase 1 defaults to read-only live snapshots disabled.
SUPPLIER_LIVE_ENABLED=false
SUPPLIER_LIVE_INTERVAL_MINUTES=5
