# Runtime environment. Never commit real secrets.
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=info

# Identity and rules (server-only)
DATABASE_URL=postgresql://football:football@localhost:5432/football_predictor
RULES_VERSION=rules-2026-07
SESSION_TTL_DAYS=30
SUPER_ADMIN_1_USERNAME=
SUPER_ADMIN_1_PASSWORD=
SUPER_ADMIN_2_USERNAME=
SUPER_ADMIN_2_PASSWORD=

# Supplier (server-only; never expose with NEXT_PUBLIC_ prefix)
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_BOOKMAKER_ID=
SUPPLIER_LEAGUE_ID=
SUPPLIER_SEASON=
SUPPLIER_WINDOW_PAST_DAYS=1
SUPPLIER_WINDOW_FUTURE_DAYS=7
SUPPLIER_FIXTURES_INTERVAL_MINUTES=60
SUPPLIER_ODDS_INTERVAL_MINUTES=10
SUPPLIER_SETTLEMENT_INTERVAL_SECONDS=60
SUPPLIER_SETTLEMENT_BATCH_SIZE=100
# Phase 1 defaults to read-only live snapshots disabled.
SUPPLIER_LIVE_ENABLED=false
SUPPLIER_LIVE_INTERVAL_MINUTES=5
