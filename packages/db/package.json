{
  "name": "@football-predictor/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "migrate": "node scripts/migrate.mjs",
    "seed:super-admins": "node scripts/seed-super-admins.mjs",
    "seed:f1-2026": "node scripts/seed-f1-2026.mjs",
    "seed:f1-official-2026": "node scripts/seed-f1-official-2026.mjs",
    "seed:e2e": "node scripts/seed-e2e.mjs"
  },
  "dependencies": {
    "@football-predictor/domain": "workspace:*",
    "@node-rs/argon2": "2.0.2",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  }
}
